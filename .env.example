# KeeperHub org API key (app.keeperhub.com -> Settings -> API Keys). Never commit.
KH_API_KEY=kh_...
# Chain + chain id (sepolia default; base-sepolia = 84532)
KEEPERHUB_CHAIN=sepolia
KEEPERHUB_CHAIN_ID=11155111
# Public RPC override (defaults to publicnode sepolia)
KEEPERHUB_RPC_OVERRIDE=https://ethereum-sepolia-rpc.publicnode.com
# Blockscout API base for balance reads
PLOW_BLOCKSCOUT=https://eth-sepolia.blockscout.com/api
# Fail closed on unavailable simulation (1 = DENY, never blind pass-through)
PLOW_FAIL_CLOSED=1
# Policy file path (defaults to server/policies.json)
PLOW_POLICY_PATH=server/policies.json
